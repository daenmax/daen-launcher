<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DaenLauncher.TodoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏：图标 + "待办"（系统关闭按钮叠在右上角，关闭 = 隐藏） ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="20" Height="20" />
                <TextBlock x:Name="TitleBarText" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- ===== 内容区：同步状态条 / 标签页 / 颜色选择 / 添加任务 / 任务列表 / 底部 =====
             标签页按钮、颜色按钮、任务列表行都由代码动态构建 -->
        <Grid Grid.Row="1" Padding="12,4,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 云同步失败提示条（仅云同步且获取失败时显示，此时写操作全部禁用） -->
            <InfoBar x:Name="SyncInfoBar" Grid.Row="0"
                     IsOpen="False" Severity="Error" IsClosable="True"
                     Margin="0,0,0,8" />

            <!-- 标签栏：全部 / 今天 / 重要 / 已完成（代码构建） -->
            <StackPanel x:Name="TabPanel" Grid.Row="1"
                        Orientation="Horizontal" Spacing="4" Margin="0,4,0,8" />

            <!-- 颜色选择：8 个颜色过滤按钮（代码构建），点选过滤，再点取消 -->
            <StackPanel x:Name="ColorPanel" Grid.Row="2"
                        Orientation="Horizontal" Spacing="3" Margin="0,0,0,8" />

            <!-- 添加任务按钮 / 行内输入框（二选一显示） -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Button x:Name="AddButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        MinHeight="42" Padding="8,5" CornerRadius="6"
                        Click="AddButton_Click">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE710;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="AddButtonText" Grid.Column="1" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
                <TextBox x:Name="AddTextBox" Visibility="Collapsed" MinHeight="42" VerticalContentAlignment="Center"
                         KeyDown="AddTextBox_KeyDown" LostFocus="AddTextBox_LostFocus" MaxLength="2000" />
            </Grid>

            <!-- 任务列表（行由代码构建） -->
            <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListPanel" Spacing="6" />
            </ScrollViewer>

            <!-- 底部：左侧统计文字，右侧"清除已完成" + "添加任务"按钮（需求：添加任务在清除已完成右边） -->
            <Grid Grid.Row="5" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" Grid.Column="0" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.7" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <!-- 同步刷新按钮（云同步未启用时隐藏） -->
                    <Button x:Name="SyncButton"
                            Padding="10,5" CornerRadius="6"
                            Click="SyncButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE895;" FontSize="13" />
                            <TextBlock x:Name="SyncButtonText" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearCompletedButton"
                            Padding="10,5" CornerRadius="6"
                            Click="ClearCompletedButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                            <TextBlock x:Name="ClearCompletedText" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <!-- 添加任务按钮：蓝色强调色 -->
                    <Button x:Name="AddTaskButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="10,5" CornerRadius="6"
                            Click="AddTaskButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock x:Name="AddTaskButtonText" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
