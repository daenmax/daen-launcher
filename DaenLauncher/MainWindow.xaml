<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DaenLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DaenLauncher.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏：左图标+标题，右侧设置按钮（系统关闭按钮叠在右上角，
             参照 DeskBox：保留系统按钮并透明化配色，右下留出系统按钮区域） ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="20" Height="20" />
                <TextBlock x:Name="TitleBarText" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- 设置按钮（与系统关闭按钮对齐：46x32，悬停有明显背景变化） -->
            <Button x:Name="SettingsButton" Grid.Column="2"
                    Style="{StaticResource TitleBarButtonStyle}"
                    VerticalAlignment="Top" Margin="0,0,2,0"
                    Click="SettingsButton_Click">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>

        <!-- ===== 内容区 ===== -->
        <Grid Grid.Row="1" Padding="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：项目分类 + 底部功能入口 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 分类列表：支持拖动上下排序（需求-说明3） -->
                <ListView x:Name="CategoryListView" Grid.Row="0"
                          SelectionMode="Single"
                          CanReorderItems="True"
                          AllowDrop="True"
                          SelectionChanged="CategoryListView_SelectionChanged"
                          ContainerContentChanging="CategoryListView_ContainerContentChanging"
                          DragItemsCompleted="CategoryListView_DragItemsCompleted"
                          RightTapped="CategoryListView_RightTapped"
                          ContextFlyout="{x:Null}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                                <ContentControl x:Name="IconHost" VerticalAlignment="Center" />
                                <TextBlock x:Name="NameText" Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 底部附属功能栏（由代码按设置动态构建：最多3个 + "更多"菜单） -->
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Padding="0,8,0,0" Margin="0,8,0,0">
                    <StackPanel x:Name="AuxBarPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" Spacing="6" />
                </Border>
            </Grid>

            <!-- 分隔条（可拖动调节左右宽度，需求-说明1；悬停显示左右光标提示） -->
            <local:SplitterGrid x:Name="Splitter" Grid.Column="1" Width="8" Margin="4,0,4,0"
                  Background="Transparent" PointerPressed="Splitter_PointerPressed"
                  PointerMoved="Splitter_PointerMoved" PointerReleased="Splitter_PointerReleased">
                <Rectangle Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Width="1" />
            </local:SplitterGrid>

            <!-- 右侧：项目面板（Tab/卡片两种风格，代码动态构建）。
                 Background=Transparent 使整个面板区域可命中拖放（需求-布局4）；
                 空白处右键弹出"添加项目"菜单（右键到项目上时由项目自己的菜单处理） -->
            <Grid Grid.Column="2" x:Name="PanelHost" Background="Transparent"
                  AllowDrop="True" DragOver="PanelHost_DragOver" Drop="PanelHost_Drop"
                  RightTapped="PanelHost_RightTapped" />
        </Grid>
    </Grid>
</Window>
