<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DaenLauncher.NoteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DaenLauncher.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏（系统关闭按钮叠在右上角，关闭 = 隐藏） ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="20" Height="20" />
                <TextBlock x:Name="TitleBarText" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- ===== 内容区：同步错误条 + 左（功能按钮+笔记列表）| 分隔条 | 右（编辑器） ===== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 云同步失败提示条（仅云同步且获取失败时显示，此时写操作全部禁用） -->
            <InfoBar x:Name="SyncInfoBar" Grid.Row="0"
                     IsOpen="False" Severity="Error" IsClosable="True"
                     Margin="8,0,8,4" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="230" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 左侧：功能按钮 + 笔记列表 ===== -->
                <Grid Grid.Column="0" Padding="8,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,4,0,6">
                        <!-- 云同步按钮（云同步未启用时隐藏） -->
                        <Button x:Name="SyncButton" Padding="10,5" CornerRadius="6"
                                Click="SyncButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="13" />
                                <TextBlock x:Name="SyncButtonText" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <!-- 添加笔记按钮 -->
                        <Button x:Name="AddButton" Style="{StaticResource AccentButtonStyle}"
                                Padding="10,5" CornerRadius="6"
                                Click="AddButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock x:Name="AddButtonText" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 笔记列表（卡片由代码构建：标题 + 创建时间；置顶在最上） -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ListPanel" Spacing="6" Margin="0,0,8,8" />
                    </ScrollViewer>
                </Grid>

                <!-- ===== 分隔条（拖动调节左右宽度；锁定尺寸时不可拖） ===== -->
                <local:SplitterGrid x:Name="Splitter" Grid.Column="1" Width="8" Margin="4,0,4,0"
                      Background="Transparent" PointerPressed="Splitter_PointerPressed"
                      PointerMoved="Splitter_PointerMoved" PointerReleased="Splitter_PointerReleased">
                    <Rectangle Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Width="1" />
                </local:SplitterGrid>

                <!-- ===== 右侧：笔记编辑面板（标题/正文/底色/置顶都在这里填，需求） ===== -->
                <Grid Grid.Column="2" Margin="0,4,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,0,0,6" Spacing="6">
                        <!-- 标题输入框 + 置顶按钮 + 保存按钮（有未保存修改时亮起，需求） -->
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EditorTitleBox" PlaceholderText="标题"
                                     MaxLength="100" TextChanged="EditorTitleBox_TextChanged" />
                            <Button x:Name="PinButton" Grid.Column="1" Width="38" Height="32"
                                    Padding="0" CornerRadius="6"
                                    Click="PinButton_Click" />
                            <Button x:Name="SaveButton" Grid.Column="2"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="10,4" CornerRadius="6"
                                    IsEnabled="False"
                                    Click="SaveButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                    <TextBlock x:Name="SaveButtonText" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- 底色色块行（代码构建） -->
                        <StackPanel x:Name="EditorColorPanel" Orientation="Horizontal" Spacing="4" />
                        <!-- 创建时间 -->
                        <TextBlock x:Name="EditorTimeText" FontSize="12" Opacity="0.6" />
                    </StackPanel>

                    <!-- 正文编辑框 -->
                    <TextBox x:Name="EditorTextBox" Grid.Row="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             TextChanged="EditorTextBox_TextChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="10,8" FontSize="14"
                             IsEnabled="False" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
